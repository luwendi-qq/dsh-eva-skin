{
  "name": "@winstonlu/dsh-eva-skin",
  "version": "1.0.73",
  "type": "module",
  "description": "EVA cel-shade skin for the DeepSeek Harness Web GUI: ink outlines, hard shadows, scanlines, session status rails. Pure client-side CSS token overrides.",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/client.js",
    "audit": "node tools/audit-selectors.mjs",
    "strip": "node tools/strip-background.mjs",
    "bg": "python tools/set-background.py",
    "pack": "python tools/set-background.py --pack-only"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "theme",
    "skin",
    "eva",
    "cel-shade",
    "evangelion"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public"
  }
}